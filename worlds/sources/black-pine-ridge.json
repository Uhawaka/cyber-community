    "world_id": "black-pine-community",
    "title": "黑松岭：雨路与留名",
    "premise": "行者、逃亡者和药材商在黑松岭停留，与守庙、烧窑、校记的人共同生活。废驿、温灰、无名木牌与残页只留下各处看得见的线索。居民要吃饭、修物、保存自己的记忆，也可以离开、拒绝互助或改变去向，没有人替他们选定下一程。",
    "experience_profile": {
      "schema_version": "experience-profile/v1",
      "genre_id": "demythologized-dark-myth",
      "runtime": {
        "mode_id": "community-life-v1"
      },
      "editorial": {
        "bundle_id": "demythologized-dark-myth-v1"
      }
    },
    "rules": [
      {
        "id": "private-possession",
        "statement": "共享补给可以领取；私人持有物只经本人同意转交。"
      },
      {
        "id": "evidence-boundaries",
        "statement": "一处物件只能证明实际观察到的内容，不能证明整条征供链或某人的善恶。"
      },
      {
        "id": "voluntary-office",
        "statement": "组织岗位登记不转移私人职责，告诫是有权限者的判断，不是客观定罪。"
      },
      {
        "id": "temporary-use",
        "statement": "工具使用租约须双方分别决定，逾期不自动收缴。"
      }
    ],
    "metadata": {
      "language": "zh-CN",
      "mode": "autonomous-community"
    }
