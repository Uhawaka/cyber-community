    "rules": [
      {
        "id": "consensual-custody",
        "statement": "共享物资的领取要进入库存记录，私人材料只有本人同意才能交割。"
      },
      {
        "id": "spring-service",
        "statement": "泉房阀门服务不足或维护停机时，院内磨坊和印坊都暂停接水；泉房自己的维修垫片由山路独立送达。"
      },
      {
        "id": "grain-to-meal",
        "statement": "粮食与水经磨坊变成粉，再由炉灶制成共享饭食；磨粉和炊事分别消耗原料并要求设备服务。"
      },
      {
        "id": "paper-and-print",
        "statement": "旧布与水经压纸机变成纸张，纸张与墨再制成印页。印页不是食物，也不意味着内容自动成为人物知识。"
      },
      {
        "id": "voluntary-labor",
        "statement": "维护是实际劳动，提案不代表同意，已经独立做完的劳动不回填成后来接受的约定。"
      },
      {
        "id": "water-powered-frames",
        "statement": "压纸与刷印由水力机架驱动。刷印只产生预装的固定边框，不替人物写字；泉房失去服务时停机，不把自动过程说成人工劳动。"
      }
    ],
    "metadata": {
      "language": "zh-CN",
      "mode": "autonomous-community"
    }
